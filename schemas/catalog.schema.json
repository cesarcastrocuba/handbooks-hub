{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://handbooks.example/schemas/catalog.schema.json",
  "title": "Handbook catalog",
  "description": "Approved book releases listed by the hub portal.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "books"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "books": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "slug",
          "title",
          "summary",
          "categories",
          "status",
          "latest_release"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,63}$"
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,63}$"
          },
          "title": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1, "maxLength": 280 },
          "categories": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{1,63}$"
            }
          },
          "status": {
            "type": "string",
            "enum": ["published", "archived"]
          },
          "latest_release": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "version",
              "tag",
              "url",
              "published_at",
              "manifest_url",
              "checksums_url"
            ],
            "properties": {
              "version": {
                "type": "string",
                "pattern": "^\\d+\\.\\d+\\.\\d+$"
              },
              "tag": {
                "type": "string",
                "pattern": "^v\\d+\\.\\d+\\.\\d+$"
              },
              "url": {
                "type": "string",
                "pattern": "^https://[^\\s]+$"
              },
              "published_at": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "manifest_url": {
                "type": "string",
                "pattern": "^https://[^\\s]+$"
              },
              "checksums_url": {
                "type": "string",
                "pattern": "^https://[^\\s]+$"
              }
            }
          }
        }
      }
    }
  }
}
