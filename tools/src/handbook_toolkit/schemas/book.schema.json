{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://handbooks.example/schemas/book.schema.json",
  "title": "Handbook book descriptor",
  "description": "Contract between a book repository and the shared toolkit and catalog.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "status",
    "profile",
    "toolkit",
    "license",
    "manuscript",
    "publication",
    "catalog"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$"
    },
    "title": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["draft", "pilot", "active", "archived"]
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        }
      }
    },
    "toolkit": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content", "code"],
      "properties": {
        "content": {
          "type": "string",
          "enum": ["CC-BY-SA-4.0", "CC-BY-4.0", "proprietary"]
        },
        "code": {
          "type": "string",
          "enum": ["MIT", "Apache-2.0", "proprietary"]
        }
      }
    },
    "manuscript": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "reading_order"],
      "properties": {
        "root": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._/-]+$"
        },
        "reading_order": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._/-]+\\.ya?ml$"
        }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "manifest"],
      "properties": {
        "formats": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["html", "pdf", "docx"]
          }
        },
        "manifest": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._/-]+\\.json$"
        }
      }
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "categories", "summary"],
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "categories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,63}$"
          }
        },
        "summary": { "type": "string", "minLength": 1, "maxLength": 280 }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "default_branch"],
      "properties": {
        "url": {
          "type": ["string", "null"],
          "pattern": "^https://[^\\s]+$"
        },
        "default_branch": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._/-]+$"
        }
      }
    }
  }
}
